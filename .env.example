# For running the apps outside Docker (pnpm dev) against `docker compose up postgres redis mailpit`.
# apps/api reads these from the environment; copy to apps/api/.env.
DATABASE_URL=postgresql://store:store@localhost:5432/store
REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025
MAIL_FROM="MVP Store <store@localhost>"
PORT=3001
# Better Auth: signs session cookies and tokens (generate with `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The web origin; email links and auth cookies use it.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Google Cloud console, "Web application"). Authorized redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google, e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# apps/web: where the /api proxy points.
API_URL=http://localhost:3001
