# For running the apps outside Docker (pnpm dev) against `docker compose up postgres redis mailpit minio minio-init`.
# apps/api reads these from the environment; copy to apps/api/.env.
DATABASE_URL=postgresql://store:store@localhost:5432/store
REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025
MAIL_FROM="MVP Store <store@localhost>"
PORT=3001
# Better Auth: signs session cookies and tokens (generate with `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The web origin; email links and auth cookies use it.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Google Cloud console, "Web application"). Authorized redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google, e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The first Admin's Google email, read by `pnpm --filter @mvp/api seed` (after a build). Sign in with Google to use it.
ADMIN_EMAIL=
# Image storage (S3-compatible). Defaults suit the Compose MinIO. For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
# an R2 API token's key pair, and STORAGE_PUBLIC_URL set to the bucket's public domain (r2.dev or custom).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Where uploaded images are served from; only URLs under it can be saved on Products and Variants.
STORAGE_PUBLIC_URL=http://localhost:9000/images
# apps/web: where the /api proxy points.
API_URL=http://localhost:3001
